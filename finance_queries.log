2026-10-31 06:10:28,330 question="Why did the South region's gross margin decrease?" sql=SELECT TOP 500 product, SUM(CASE WHEN [date] >= '2026-04-01' AND [date] < '2026-07-01' THEN revenue ELSE 0 END) AS current_revenue, SUM(CASE WHEN [date] >= '2026-04-01' AND [date] < '2026-07-01' THEN cost ELSE 0 END) AS current_cost, SUM(CASE WHEN [date] >= '2026-01-01' AND [date] < '2026-04-01' THEN revenue ELSE 0 END) AS previous_revenue, SUM(CASE WHEN [date] >= '2026-01-01' AND [date] < '2026-04-01' THEN cost ELSE 0 END) AS previous_cost, (SUM(CASE WHEN [date] >= '2026-04-01' AND [date] < '2026-07-01' THEN revenue - cost ELSE 0 END) * 1.0 / NULLIF(SUM(CASE WHEN [date] >= '2026-04-01' AND [date] < '2026-07-01' THEN revenue ELSE 0 END), 0)) AS current_margin, (SUM(CASE WHEN [date] >= '2026-01-01' AND [date] < '2026-04-01' THEN revenue - cost ELSE 0 END) * 1.0 / NULLIF(SUM(CASE WHEN [date] >= '2026-01-01' AND [date] < '2026-04-01' THEN revenue ELSE 0 END), 0)) AS previous_margin FROM dbo.fact_finance WHERE market = 'US' AND region = 'South' AND [date] >= '2026-01-01' AND [date] < '2026-07-01' GROUP BY product ORDER BY current_margin ASC
